{
  "manifestVersion": 3,
  "kind": "subShell",
  "id": "shell-template",
  "hostRef": "main",
  "hostApiVersion": "1.0.0",
  "hostCompat": ">=1.0.0 <2.0.0",
  "version": "0.2.0-edge.1",
  "title": "Shell Template",
  "description": "OpenSphere Shell Template subShell.",
  "entry": "ui-shell.plugin.js",
  "entrySha256": "a4c08789ed5b2a77639a954bb5353195ea8ffa8f363305f92094f990a70ff10d",
  "shellCompat": ">=0.2.0 <0.9.0",
  "sdkVersion": "0.3.0",
  "permissions": [
    "page:register",
    "api:proxy",
    "nav:contribute",
    "search:contribute",
    "manual:contribute",
    "notify:publish"
  ],
  "nav": {
    "band": "구축 Build",
    "label": "Shell Template"
  },
  "designSystem": "clarity",
  "apiBase": "/api/plugins/shell-template",
  "renderMode": "esm",
  "contributions": {
    "page": {
      "enabled": true
    },
    "navigation": {
      "enabled": true,
      "mode": "runtime"
    },
    "api": {
      "enabled": true,
      "basePath": "/api/plugins/shell-template"
    },
    "cli": {
      "enabled": true,
      "namespace": "template",
      "manifestPath": "/cli/manifest"
    },
    "manual": {
      "enabled": true,
      "sourceId": "plugin:shell-template",
      "mode": "runtime"
    },
    "search": {
      "enabled": true,
      "mode": "runtime"
    },
    "notification": {
      "enabled": true,
      "frontend": true,
      "backend": false,
      "reason": "Reference template publishes lifecycle state through the host-owned frontend notification seam"
    },
    "observability": {
      "enabled": true,
      "logs": true,
      "metrics": true,
      "traces": true
    }
  }
}
