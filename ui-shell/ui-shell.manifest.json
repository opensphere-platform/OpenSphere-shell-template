{
  "manifestVersion": 3,
  "kind": "subShell",
  "id": "shell-template",
  "hostRef": "main",
  "hostApiVersion": "1.0.0",
  "hostCompat": ">=1.0.0 <2.0.0",
  "version": "0.2.1-edge.1",
  "title": "Shell Template",
  "description": "OpenSphere Shell Template subShell.",
  "entry": "ui-shell.plugin.js",
  "entrySha256": "4aeabd8f084d5f304296a529ea7881b6acb668b4f4eb75f3df64cb0cdcc3b2b3",
  "shellCompat": ">=0.2.0 <0.9.0",
  "sdkVersion": "0.3.1",
  "permissions": [
    "page:register",
    "api:proxy",
    "search:contribute",
    "manual:contribute",
    "notify:publish"
  ],
  "nav": {
    "band": "구축 Build",
    "label": "Shell Template"
  },
  "designSystem": "clarity",
  "apiBase": "/api/plugins/shell-template",
  "renderMode": "esm",
  "contributions": {
    "page": {
      "enabled": true
    },
    "navigation": {
      "enabled": false,
      "mode": "none",
      "reason": "Main Shell exposes one flat page entry; Shell Template owns its domain navigation tree inside the subShell page"
    },
    "api": {
      "enabled": true,
      "basePath": "/api/plugins/shell-template"
    },
    "cli": {
      "enabled": true,
      "namespace": "template",
      "manifestPath": "/cli/manifest"
    },
    "manual": {
      "enabled": true,
      "sourceId": "plugin:shell-template",
      "mode": "runtime"
    },
    "search": {
      "enabled": true,
      "mode": "runtime"
    },
    "notification": {
      "enabled": true,
      "frontend": true,
      "backend": false,
      "reason": "Reference template publishes lifecycle state through the host-owned frontend notification seam"
    },
    "observability": {
      "enabled": true,
      "logs": true,
      "metrics": true,
      "traces": true
    }
  },
  "assets": [
    {
      "id": "app",
      "path": "../app/main.js",
      "type": "module",
      "sha256": "81d05337b1e1faf7504ca15e231e18b34551e96c0b7efc59039a50a3dee3d9f3"
    },
    {
      "id": "styles",
      "path": "../app/styles.css",
      "type": "style",
      "sha256": "c0871a84b21f528f140bf30a0aa251df24eb2ec76f65b42d334f079099700a52"
    }
  ]
}
